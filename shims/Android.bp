cc_library {
    name: "libmisightjson_shim",
    srcs: [
        "json_value.cpp",
    ],
	shared_libs: ["libjsoncpp"],
    compile_multilib: "both",
    vendor: true,
}

cc_library {
    name: "wfdservice_shim",
    srcs: ["wfdservice.c"],
}

cc_library_shared {
    name: "dolbycodec_shim",
    srcs: ["dolbycodec_shim.cpp"],
    shared_libs: ["libutils"],
    device_specific: true,
}